{
    "name": "exemplo/projeto",
    "description": "Projeto PHP com PHP 5.3.3 e dependências compatíveis",
    "version": "1.0.0",
    "type": "project",
    "require": {
        "php": ">=5.3.3",
        "ext-date": "*",
        "ext-zlib": "*",
        "ext-hash": "*",
        "ext-filter": "*",
        "ext-spl": "*",
        "ext-simplexml": "*",
        "ext-tokenizer": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-phar": "*",
        "ext-sqlite3": "*",
        "ext-xmlreader": "*",
        "ext-xmlwriter":"*",
        "ext-xsl": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "3.7.*"
    },
    "config": {
        "platform": {
            "php": "5.3.3"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"echo 'Instalação concluída';\""
        ]
    }
}
