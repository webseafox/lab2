# ==============================================================================
# Arquivo: deploy_commands
# Descrição: Script utilizado para depuração e validação do ambiente de deploy
# do BRM Fenix. Exibe variáveis de ambiente, consulta namespaces do Kubernetes,
# mostra informações sobre o último pipeline executado e realiza teste de erro.
# ==============================================================================

# Exibe o valor da variável de ambiente ENVIRONMENT para depuração
printf "##[debug] ENVIRONMENT............................................: $ENVIRONMENT"

# Exibe o caminho do Helm do host de operação para depuração
printf "##[debug] OPERATION HOST HELM PATH...............................: $OPERATION_HOST_HELM_PATH"

# Exibe o arquivo do Helm Chart utilizado para deploy
printf "##[debug] HELM CHART FILE........................................: $HELM_CHART_FILE"

# Exibe a versão do release do BRM Core para depuração
printf "##[debug] BRM CORE RELEASE VERSION...............................: $BRM_CORE_RELEASE_VERSION"

# Lista todos os namespaces existentes no cluster Kubernetes
echo "##[command]kubectl get namespaces"
kubectl get namespaces

# Exibe o conteúdo do arquivo que registra o último pipeline executado
echo "##[command]cat $OPERATION_HOST_HELM_PATH/package-oc-cn-helm-chart/last-pipeline-run"
cat $OPERATION_HOST_HELM_PATH/package-oc-cn-helm-chart/last-pipeline-run

# Testa a saída de erro para validação do pipeline
echo "##[command]echo error teste"
echo "error teste"