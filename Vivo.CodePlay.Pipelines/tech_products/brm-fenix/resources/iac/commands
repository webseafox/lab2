echo "##[debug] ACTION ....................................................: $ACTION"
echo "##[debug] ENVIRONMENT ...............................................: $ENVIRONMENT"
echo "##[debug] OCI CLI CONFIG FILE .......................................: $OCI_CLI_CONFIG_FILE"
echo "##[debug] NODES .....................................................: $LIMITED_NODES"
echo "##[debug] NUMBER OF AFFECTED NODES ..................................: $NUMBER_AFFECTED_NODES"

for NODE in $(echo "$LIMITED_NODES" | tr ';' '\n'); do
    WAIT_STATE=""

    NODE_INDEX=$(( NODE_INDEX + 1 ))
    NODE_ID=$(echo "$NODE" | awk -F',' '{print $1}')
    NODE_NAME=$(echo "$NODE" | awk -F',' '{print $2}')
    NODE_PRIVATE_IP=$(echo "$NODE" | awk -F',' '{print $3}')

    if [ "$ACTION" == "START" ]; then
        WAIT_STATE="RUNNING"
    elif [ "$ACTION" == "STOP" ]; then
        WAIT_STATE="STOPPED"
    fi

    echo ""
    echo ">>>>>>>>>> $ACTION Node $NODE_INDEX ..."
    echo ">>>>> Name: $NODE_NAME"
    echo ">>>>> id: $NODE_ID"
    echo ">>>>> ip: $NODE_PRIVATE_IP"
    echo "##[command]oci compute instance action --instance-id $NODE_ID --action $ACTION --wait-for-state $WAIT_STATE --wait-interval-seconds 10 --max-wait-seconds 2000"
    RETURN=$(oci compute instance action --instance-id $NODE_ID --action $ACTION --wait-for-state $WAIT_STATE --wait-interval-seconds 10 --max-wait-seconds 2000)

    echo "##[group]Return all Informations"
    echo "$RETURN" | jq '.'
    echo "##[endgroup]"

    NODE_ID=$(echo "$RETURN" | jq -r '.data.id')
    NODE_DISPLAY_NAME=$(echo "$RETURN" | jq -r '.data."display-name"')
    NODE_LIFECYCLE_STATE=$(echo "$RETURN" | jq -r '.data."lifecycle-state"')
    NODE_CLUSTER_NAME=$(echo "$RETURN" | jq -r '.data."system-tags"."orcl-containerengine".Cluster')
    NODE_POOL_ID=$(echo "$RETURN" | jq -r '.data."system-tags"."orcl-containerengine".NodePool')

    echo "##[debug] Node ID ................................................: $NODE_ID"
    echo "##[debug] Node Display Name ......................................: $NODE_DISPLAY_NAME"
    echo "##[debug] Node Lifecycle State ...................................: $NODE_LIFECYCLE_STATE"
    echo "##[debug] OKE NodePool ID ........................................: $NODE_POOL_ID"
    echo "##[debug] Cluster ................................................: $NODE_CLUSTER_NAME"
done